{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.floriantriclin/mindyard",
  "title": "mindyard",
  "description": "Personal LLM wiki: a git-versioned Markdown vault that Claude reads and edits over MCP",
  "websiteUrl": "https://mindyard.dev",
  "repository": {
    "url": "https://github.com/floriantriclin/mindyard",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "mindyard",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "MINDYARD_DATA_ROOT",
          "description": "Directory holding vaults/ (create one with: mindyard init <data root>/vaults/garden --demo)",
          "format": "filepath",
          "isRequired": true
        }
      ]
    }
  ]
}
